location ~ ^/cms-api/seo/blog/public/(?<cms_slug>[a-z0-9]+(?:-[a-z0-9]+)*)$ {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:48081/app-api/seo/blog/public/$cms_slug?siteId=1&locale=$arg_locale;
    client_max_body_size 16k;
    proxy_set_header tenant-id 163;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header visit-tenant-id "";
