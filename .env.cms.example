# Copy to .env.local only after the ERP migration is applied.
# Public flag: it deliberately disables legacy hardcoded content for the CMS-managed hero.
VITE_CMS_ENABLED=true
# Server-side Vite proxy configuration. Replace with the actual test ERP address and tenant ID.
CMS_UPSTREAM=http://127.0.0.1:48080
CMS_TENANT_ID=
